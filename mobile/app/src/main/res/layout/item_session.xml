<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingLeft="12dp"
    android:paddingEnd="4dp"
    android:paddingRight="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/fd_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/fd_text_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/minus"
        style="@style/Widget.Inventory.Button.Stepper"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/session_fewer"
        android:text="@string/sign_minus" />

    <TextView
        android:id="@+id/packages"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/fd_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/plus"
        style="@style/Widget.Inventory.Button.Stepper"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/session_more"
        android:text="@string/sign_plus" />

    <ImageButton
        android:id="@+id/remove"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:layout_marginLeft="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/session_remove"
        android:src="@android:drawable/ic_menu_delete" />
</LinearLayout>
